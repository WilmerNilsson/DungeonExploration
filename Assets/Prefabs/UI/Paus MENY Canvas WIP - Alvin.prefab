  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Jess\u2019s journal\r\n\r\nEver since I got here to G\xFCnhildr all I
    hear is Agathol this and Agathol that. Is there truly nothing else in this CITY,
    mind you, than this blasted dungeon? That\u2019s what most of the locals seem
    to convey at least. I don\u2019t get it. It doesn\u2019t seem that out of the
    ordinary from what I can gather.\n\nI get it now, I now see why so many venture
    down. Everything is down there. Everything I could ever want, everything I\u2019ll
    ever need. I\u2019ll be there soon, Agathol.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 56321e81821ad78428942d9943f1e90d, type: 2}
